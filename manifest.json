{
  "manifest_version": 3,
  "name": "DeskTab - Modern Desktop New Tab",
  "version": "1.5.0",
  "description": "A clean, customizable desktop-style start page with a responsive dock, widgets, and search.",
  "icons": {
    "16": "assets/iconmain.png",
    "48": "assets/iconmain.png",
    "128": "assets/iconmain.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/*"
  ]
}
